# From `supabase status` after `pnpm db:start`
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Optional: Sentry error tracking (spec §5.9). Errors are scrubbed of names, request bodies and the
# household id before they leave the device (src/app/errorTracking.ts). Leave unset to disable entirely.
VITE_SENTRY_DSN=
